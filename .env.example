# --- Telegram ---
TELEGRAM_BOT_TOKEN=put-your-botfather-token-here
# Comma-separated Telegram user IDs allowed to use the bot (bootstrap fallback).
ALLOWED_TELEGRAM_IDS=111111111,222222222
# First admin (can /genkey /revoke /keys). Falls back to first ALLOWED id.
ADMIN_TELEGRAM_ID=

# --- Rust server pairing (from `npm run pair` / fcm-listen of the BOT account) ---
RUST_SERVER_IP=1.2.3.4
RUST_SERVER_PORT=28017
RUST_PLAYER_ID=7656119xxxxxxxxxx
RUST_PLAYER_TOKEN=-123456789
RUST_SERVER_ID=

# --- Optional: friend online tracking ---
STEAM_API_KEY=

# --- Onboarding (desktop helper -> bot) ---
INGEST_PORT=8787
# Public HTTPS URL of the ingest endpoint (e.g. Cloudflare Tunnel). Baked into the helper.
PUBLIC_INGEST_URL=
# Where users download the pairing helper (.exe).
HELPER_DOWNLOAD_URL=

# --- Enemy tracking (BattleMetrics) — ONE operator token serves ALL users ---
# Customers never touch BattleMetrics; you set this once. Get it at
# battlemetrics.com -> Account -> Developers -> New Token.
BATTLEMETRICS_TOKEN=
# Optional override. Normally the server is auto-detected from each user's
# paired IP, so leave this blank.
BM_SERVER_ID=
# Timezone offset (hours) for enemy activity heatmaps. Default 3 (Moscow).
TZ_OFFSET_HOURS=3

# --- Map rendering ---
# Tactical map PNG (jimp) is memory-heavy. Keep 'off' on a 1 GB box (fits more
# concurrent sessions); /map then lists live markers as text + a RustMaps link.
# Set to 'on' once you have >=2 GB RAM to re-enable the rendered image.
MAP_RENDER=off

# --- Storage ---
DB_PATH=./data/bot.db
